# Copy this file to .env before running npm run test:e2e.
# These values are read by the Claude Agent SDK / Claude Code runtime.
ANTHROPIC_BASE_URL=your_anthropic_base_url_here
ANTHROPIC_AUTH_TOKEN=your_anthropic_auth_token_here
ANTHROPIC_MODEL=claude-opus-4-6
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# Windows users may need this when Claude Code needs Git Bash explicitly.
# CLAUDE_CODE_GIT_BASH_PATH=C:\\Program Files\\Git\\bin\\bash.exe
